{
  "name": "doctor-tracker-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js administrative frontend for Doctor Tracker",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "engines": { "node": ">=22" }
}
